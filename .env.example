# ============================================================================
# 环境变量配置文件
# ============================================================================
# 复制此文件为 .env 并填入你的 API 密钥
# cp .env.example .env
# 系统要求：Python 3.10+

# ============================================================================
# 🚀 LLM 配置
# ============================================================================

# 模型名称 (deepseek-chat, gpt-4o, etc.)
LLM_MODEL_ID=your-model-id

# API 密钥
LLM_API_KEY=your-api-key

# 服务地址 (如 https://api.deepseek.com, https://api.openai.com)
LLM_BASE_URL=your-base-url

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# ============================================================================
# 🛠️ 工具配置（可选）
# ============================================================================

# Tavily搜索 - 获取API密钥：https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key

# SerpApi搜索 - 获取API密钥：https://serpapi.com/
SERPAPI_API_KEY=your-serpapi-api-key

# ============================================================================
# 🔢 Qdrant 向量数据库配置
# ============================================================================
# 获取API密钥：https://cloud.qdrant.io/

# 使用Qdrant云服务（推荐）
QDRANT_URL=your-qdrant-url
QDRANT_API_KEY=your-qdrant-api-key

# 或使用本地Qdrant（需要Docker）
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Qdrant集合配置
QDRANT_COLLECTION=qa_system_vectors
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ============================================================================
# 🕸️ Neo4j 图数据库配置（可选）
# ============================================================================
# 获取API密钥：https://neo4j.com/cloud/aura/

# 使用Neo4j Aura云服务（推荐）
NEO4J_URI=your-neo4j-uri
NEO4J_USERNAME=your-neo4j-username
NEO4J_PASSWORD=your-neo4j-password

# 或使用本地Neo4j（需要Docker）
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=hello-agents-password

# Neo4j连接配置
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ============================================================================
# 🧠 Embedding 配置
# ============================================================================
# 可从阿里云控制台获取：https://dashscope.aliyun.com/

# dashscope / openai / local
EMBED_MODEL_TYPE=dashscope

# text-embedding-v3 / text-embedding-3-small / all-MiniLM-L6-v2
EMBED_MODEL_NAME=text-embedding-v3

# API 密钥
EMBED_API_KEY=your-embedding-api-key

# 服务地址
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
